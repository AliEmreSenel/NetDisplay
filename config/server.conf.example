# Source. One daemon accepts several receiver computers concurrently.
listen=0.0.0.0
port=5001
# Base destination port. A client uses video_port + display index; different
# client IPs may safely use the same range.
video_port=5000
max_clients=8
max_displays_per_client=8
max_width=8192
max_height=8192
max_fps=240
allowed_peer=

# Prefix for per-client/per-display output names created by connect_cmd.
output=netdisplay
# Physical host output whose DPMS state is mirrored. Blank selects the first
# non-NetDisplay Wayland output.
source_output=
# Host backlight name from /sys/class/backlight, an absolute directory, auto,
# or none. Changes are pushed immediately over the control connection.
brightness_device=auto
qp=24

# A password key makes interactive clients prompt when they connect. Generate
# it by running `netdisplay-server --derive-password-key`; the password itself
# is neither stored here nor sent over the network.
password_key=

# For unattended clients, use a PSK file instead of password. A PSK file
# contains exactly 32 random bytes or 64 hexadecimal characters. Configure
# exactly one of password_key or psk_file.
psk_file=
# Password/PSK authentication and video encryption are separate. off keeps
# video UDP plaintext even after successful authentication; allowed accepts the
# client's choice; required rejects plaintext clients. Encryption requires a
# password_key or psk_file and is never silently downgraded.
frame_encryption=off

# Video codec policy. auto prefers AV1, then HEVC/H.265, then H.264, but only
# when the receiver advertises hardware decode and this source can actually open
# a hardware encoder for every requested display. A forced codec never falls back.
video_codec=auto

# Source-side gate. A receiver cannot enable this remotely.
input_enabled=0

# LOCAL lifecycle hooks only. The network protocol has no command/string field.
# Invoked once per display. Environment: ND_PEER_IP ND_OUTPUT ND_CONNECTOR
# ND_DISPLAY_ID ND_VIDEO_PORT ND_CONTROL_PORT ND_WIDTH ND_HEIGHT ND_REFRESH_HZ
# ND_TOUCH_DEVICE (nonempty on the first display of a direct-touch session).
# Bind that device to its streamed output, so taps do not hit another monitor.
# Hyprland's current live configuration API is Lua. Remove only this session's
# exact output name first so a stale connector left by a crashed/restarted
# daemon cannot make `output create` fail with "Name already taken".
connect_cmd=hyprctl output remove "$ND_OUTPUT" >/dev/null 2>&1 || true; hyprctl output create headless "$ND_OUTPUT" && hyprctl eval "hl.monitor({ output = '$ND_OUTPUT', mode = '${ND_WIDTH}x${ND_HEIGHT}@${ND_REFRESH_HZ}', position = 'auto', scale = 1 })" && { [ -z "$ND_TOUCH_DEVICE" ] || hyprctl eval "hl.device({ name = '$ND_TOUCH_DEVICE', output = '$ND_OUTPUT' })"; }
disconnect_cmd=hyprctl output remove "$ND_OUTPUT"

# Mirror receiver batteries and chargers as native device-scoped power supplies.
# Requires the optional netdisplay-power DKMS module; otherwise video still works.
power_devices=1

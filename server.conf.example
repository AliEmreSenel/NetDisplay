# Victus / source. One daemon, one built-in video sender.
listen=0.0.0.0
port=5001
video_port=5000
allowed_peer=

# The output name created by connect_cmd and captured by the built-in sender.
output=T490
width=1920
height=1080
refresh_hz=60
qp=24

# Source-side gate. A receiver cannot enable this remotely.
input_enabled=0

# LOCAL lifecycle hooks only. The network protocol has no command/string field.
# Environment: ND_PEER_IP ND_OUTPUT ND_VIDEO_PORT ND_CONTROL_PORT
#              ND_WIDTH ND_HEIGHT ND_REFRESH_HZ
connect_cmd=hyprctl output create headless "$ND_OUTPUT"; hyprctl keyword monitor "$ND_OUTPUT,${ND_WIDTH}x${ND_HEIGHT}@${ND_REFRESH_HZ},auto-right,1"
disconnect_cmd=hyprctl output remove "$ND_OUTPUT"

{
  "version": 2,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON",
        "NETDISPLAY_BUILD_SERVER": "OFF",
        "NETDISPLAY_BUILD_CLIENT": "OFF",
        "NETDISPLAY_BUILD_VR": "OFF",
        "NETDISPLAY_BUILD_STEAMVR": "OFF"
      }
    },
    {
      "name": "desktop",
      "inherits": "base",
      "cacheVariables": {
        "NETDISPLAY_BUILD_SERVER": "ON",
        "NETDISPLAY_BUILD_CLIENT": "ON"
      }
    },
    {
      "name": "core",
      "inherits": "base",
      "displayName": "Hardware-independent protocol and device tests"
    },
    {
      "name": "vr",
      "inherits": "base",
      "cacheVariables": {
        "NETDISPLAY_BUILD_VR": "ON",
        "NETDISPLAY_BUILD_STEAMVR": "ON",
        "OPENVR_INCLUDE_DIR": "$env{OPENVR_INCLUDE_DIR}"
      }
    },
    {
      "name": "all",
      "inherits": "desktop",
      "cacheVariables": {
        "NETDISPLAY_BUILD_VR": "ON",
        "NETDISPLAY_BUILD_STEAMVR": "ON",
        "OPENVR_INCLUDE_DIR": "$env{OPENVR_INCLUDE_DIR}"
      }
    }
  ],
  "buildPresets": [
    { "name": "desktop", "configurePreset": "desktop" },
    { "name": "core", "configurePreset": "core" },
    { "name": "vr", "configurePreset": "vr" },
    { "name": "all", "configurePreset": "all" }
  ],
  "testPresets": [
    { "name": "desktop", "configurePreset": "desktop", "output": { "outputOnFailure": true } },
    { "name": "core", "configurePreset": "core", "output": { "outputOnFailure": true } },
    { "name": "vr", "configurePreset": "vr", "output": { "outputOnFailure": true } },
    { "name": "all", "configurePreset": "all", "output": { "outputOnFailure": true } }
  ]
}
